{{- $gpu := output "sh" "-c" "v=$(cat /sys/class/drm/card[0-9]/device/vendor 2>/dev/null); case \"$v\" in *0x10de*) printf nvidia;; *0x8086*) printf intel;; *) printf amd;; esac" | trim -}}
{{- $hostname := .chezmoi.hostname -}}

[data]
    hostname = {{ $hostname | quote }}
    gpu = {{ $gpu | quote }}
