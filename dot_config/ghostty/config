# =============================================================================
# Ghostty Configuration — Onyx and Platinum
# =============================================================================
# Ported from Kitty to preserve the exact look and feel.
# =============================================================================

# -----------------------------------------------------------------------------
# Typography
# -----------------------------------------------------------------------------

font-family = CaskaydiaCove Nerd Font
font-style = Bold
font-style-italic = Bold Italic
font-size = 12.5

# -----------------------------------------------------------------------------
# Colors — Onyx and Platinum
# -----------------------------------------------------------------------------

foreground = #e5e5e5
background = #111111
selection-foreground = #111111
selection-background = #e5e5e5

cursor-color = #e5e5e5
cursor-text = #111111
cursor-style = bar
cursor-style-blink = true

# The 16 terminal colors (muted/desaturated palette)

# Black / Charcoal
palette = 0=#1c1c1c
palette = 8=#3d3d3d

# Red (Muted)
palette = 1=#d75f5f
palette = 9=#d75f5f

# Green (Muted)
palette = 2=#87af87
palette = 10=#87af87

# Yellow (Muted)
palette = 3=#dfaf87
palette = 11=#dfaf87

# Blue (Muted)
palette = 4=#87afaf
palette = 12=#87afaf

# Magenta (Muted)
palette = 5=#af87af
palette = 13=#af87af

# Cyan (Muted)
palette = 6=#87afd7
palette = 14=#87afd7

# White (Platinum)
palette = 7=#e5e5e5
palette = 15=#ffffff

# -----------------------------------------------------------------------------
# Window & Chrome
# -----------------------------------------------------------------------------

window-padding-x = 8
window-padding-y = 8
window-padding-color = background
window-theme = dark
window-decoration = auto
gtk-titlebar = true
gtk-tabs-location = top

# -----------------------------------------------------------------------------
# Shell Integration
# -----------------------------------------------------------------------------

shell-integration = detect
shell-integration-features = cursor,sudo,title

# -----------------------------------------------------------------------------
# Behavior
# -----------------------------------------------------------------------------

mouse-hide-while-typing = true
confirm-close-surface = true
quit-after-last-window-closed = true
clipboard-read = allow
clipboard-write = allow
scrollback-limit = 10000000

# -----------------------------------------------------------------------------
# Shaders & Effects
# -----------------------------------------------------------------------------

custom-shader = shaders/cursor_lightning.glsl
custom-shader = shaders/cursor_warp.glsl
custom-shader-animation = always


