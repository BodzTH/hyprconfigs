/* HyprBlur Round QSS for Fusion Style */
QPushButton, QToolButton, QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox, QTimeEdit, QDateEdit, QDateTimeEdit {
    border-radius: 6px;
    padding: 4px 8px;
    border: 1px solid #3d3d3d;
    background-color: #1c1c1c;
    color: #e5e5e5;
}

QPushButton:hover, QToolButton:hover, QComboBox:hover {
    background-color: #2d2d2d;
}

QMenu {
    border-radius: 8px;
    border: 1px solid #3d3d3d;
    background-color: #111111;
    padding: 4px;
}

QMenu::item {
    border-radius: 4px;
    padding: 4px 20px 4px 20px;
}

QMenu::item:selected {
    background-color: #2d2d2d;
}

QProgressBar {
    border-radius: 4px;
    border: 1px solid #3d3d3d;
    background-color: #1c1c1c;
}

QProgressBar::chunk {
    border-radius: 3px;
    background-color: #e5e5e5;
}

QToolTip {
    border-radius: 6px;
    border: 1px solid #3d3d3d;
    background-color: #111111;
    color: #e5e5e5;
    padding: 4px;
}
