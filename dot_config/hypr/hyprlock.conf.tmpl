# Hyprlock — HyprBlur Theme
# Ported from old catppuccin config with monochrome color palette
# See: https://wiki.hypr.land/Hypr-Ecosystem/hyprlock/

# ▓▒░ HYPRBLUR COLOR PALETTE
$base     = rgb(111111)
$mantle   = rgb(1c1c1c)
$surface0 = rgb(2d2d2d)
$text     = rgb(e5e5e5)
$subtext  = rgb(888888)
$accent   = rgb({{ template "accent" . }})
$red      = rgb(d75f5f)
$green    = rgb(a3be8c)

# Hex-only variants for Pango markup (no 0x prefix)
$textAlpha   = e5e5e5
$accentAlpha = {{ template "accent" . }}

$font = CaskaydiaCove Nerd Font Italic
$iconFont = CaskaydiaCove Nerd Font

# ▓▒░ GENERAL
# NOTE: no_fade_in, grace, and disable_loading_bar were removed upstream.
#       Grace period is now passed as the --grace CLI flag (see hypridle.conf).
# Cursor stays visible: the power buttons below need it.
general {
    hide_cursor = false
}

# ▓▒░ BACKGROUND — transparent background with Hyprland session blur
background {
    monitor     =
    color       = rgba(0,0,0,0)
    blur_passes = 0
}

# ▓▒░ CLOCK — large time display at top
label {
    monitor     =
    text        = $TIME
    color       = $text
    font_size   = 90
    font_family = $font
    position    = 0, -400
    halign      = center
    valign      = top
}

# ▓▒░ DATE — below the clock
# Re-read every minute. It used to be every 12h, so a lock that spanned
# midnight kept showing the previous day for up to 12 hours.
label {
    monitor     =
    text        = cmd[update:60000] date +"%A, %d %B %Y"
    color       = $text
    font_size   = 25
    font_family = $font
    position    = 0, -350
    halign      = center
    valign      = top
}

# ▓▒░ KEYBOARD LAYOUT INDICATOR
# SUPER+K switches layout while locked (a `locked` bind in keybindings.lua);
# hyprlock follows the compositor's xkb group, so this updates immediately.
# Plain $LAYOUT (xkb's own name) rather than $LAYOUT[en,ar]: an indexed list
# breaks on a host whose kb_layout has a different count.
label {
    monitor     =
    text        = 󰌌  $LAYOUT
    color       = $subtext
    font_size   = 18
    font_family = $font
    position    = 0, -300
    halign      = center
    valign      = top
}

# ▓▒░ PASSWORD INPUT FIELD
input-field {
    monitor          =
    size             = 300, 60
    outline_thickness = 4
    dots_size        = 0.2
    dots_spacing     = 0.2
    dots_center      = true
    outer_color      = $accent
    inner_color      = $surface0
    font_color       = $text
    fade_on_empty    = true
    placeholder_text = <span foreground="##$textAlpha"><i>󰌾 Logged in as </i><span foreground="##$accentAlpha">{{ .displayName | replace "&" "&amp;" | replace "<" "&lt;" }}</span></span>
    hide_input       = false
    check_color      = $accent
    fail_color       = $red
    fail_text        = <i>$FAIL <b>($ATTEMPTS)</b></i>
    capslock_color   = $green
    position         = 0, -120
    halign           = center
    valign           = center
}

# ▓▒░ POWER BUTTONS — sleep / reboot / shutdown, bottom centre
# Bare white glyphs, accent on hover or ←/→ selection; Enter fires a selected
# one. hyprlock has no hover state or keybinds of its own:
# scripts/lock_buttons.py watches the cursor, takes the keys from a lock-only
# submap (modules/keybindings.lua), and re-runs these `:1` labels via SIGUSR2.
# The icons and actions live in its BUTTONS; the x offsets and BOTTOM there
# must match these positions.
label {
    monitor     =
    text        = cmd[update:0:1] ~/.config/hypr/scripts/lock_buttons.py sleep $accentAlpha
    font_size   = 26
    font_family = $iconFont
    onclick     = ~/.config/hypr/scripts/lock_buttons.py run sleep
    position    = -100, 60
    halign      = center
    valign      = bottom
}

label {
    monitor     =
    text        = cmd[update:0:1] ~/.config/hypr/scripts/lock_buttons.py reboot $accentAlpha
    font_size   = 26
    font_family = $iconFont
    onclick     = ~/.config/hypr/scripts/lock_buttons.py run reboot
    position    = 0, 60
    halign      = center
    valign      = bottom
}

label {
    monitor     =
    text        = cmd[update:0:1] ~/.config/hypr/scripts/lock_buttons.py shutdown $accentAlpha
    font_size   = 26
    font_family = $iconFont
    onclick     = ~/.config/hypr/scripts/lock_buttons.py run shutdown
    position    = 100, 60
    halign      = center
    valign      = bottom
}
