@import url("file://{{ .chezmoi.homeDir }}/.themes/Graphite-Dark/gtk-4.0/gtk-dark.css");

/* Dynamic Accent & Dialog Border Colors */
@define-color accent_color #{{ template "accent" . }};
@define-color accent_bg_color #{{ template "accent" . }};
@define-color accent_fg_color #{{ template "accent_fg" . }};

/* Dynamic Dialog / Sheet / Modal Borders */
floating-sheet > sheet,
dialog sheet,
window.dialog sheet,
messagedialog sheet {
  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.2), 0 10px 18px rgba(0, 0, 0, 0.14), 0 8px 24px rgba(0, 0, 0, 0.12), 0 0 0 2px @accent_color;
}

/* Checked framed toggle buttons (pavucontrol's "set as default" check, etc.):
   Graphite paints them as a solid accent disk that swallows the icon. Tint
   them with a thin accent ring instead, so the icon stays visible and the
   checked one still stands out from its flat neighbours (pavucontrol's lock). */
button.toggle:checked:not(.flat):not(.suggested-action):not(.destructive-action) {
  background-color: alpha(@accent_color, 0.22);
  box-shadow: inset 0 0 0 1px alpha(@accent_color, 0.7);
  color: @accent_color;
}
button.toggle:checked:hover:not(.flat):not(.suggested-action):not(.destructive-action) {
  background-color: alpha(@accent_color, 0.30);
}
