# vim:ft=kitty

## name:     HyprBlur
## author:   User
## license:  MIT
## blurb:    Elegant monochrome for the modern minimalist.

# -----------------------------------------------------------------------------
# Core Typographic Engine
# -----------------------------------------------------------------------------

font_family      CaskaydiaCove Nerd Font
bold_font        auto
italic_font      auto
bold_italic_font auto

font_size            12.5
window_padding_width 8

# -----------------------------------------------------------------------------
# Rendering Tweaks
# -----------------------------------------------------------------------------

text_composition_strategy platform
disable_ligatures never
adjust_line_height  100%
adjust_column_width 100%
box_drawing_scale 0.001, 1, 1.5, 2

# -----------------------------------------------------------------------------
# Theme Colors (HyprBlur)
# -----------------------------------------------------------------------------

foreground              #e5e5e5
background              #111111
selection_foreground    #111111
selection_background    #e5e5e5

# Cursor colors (`cursor` is the wallpaper accent, rewritten by
# ~/.config/hypr/scripts/sync_border.py; kitty auto-reloads)
cursor                  #{{ template "accent" . }}
cursor_text_color       #111111

# Scrollbar colors
scrollbar_handle_color  #888888
scrollbar_track_color   #1c1c1c

# URL color when hovering
url_color               #888888

# Kitty window border colors
active_border_color     #e5e5e5
inactive_border_color   #1c1c1c
bell_border_color       #555555

# OS Window titlebar colors
wayland_titlebar_color system
macos_titlebar_color system

# Tab bar colors (Platinum active, Onyx inactive)
active_tab_foreground   #111111
active_tab_background   #e5e5e5
inactive_tab_foreground #888888
inactive_tab_background #1c1c1c
tab_bar_background      #0a0a0a

# Colors for marks
mark1_foreground #111111
mark1_background #e5e5e5
mark2_foreground #111111
mark2_background #888888
mark3_foreground #111111
mark3_background #444444

# -----------------------------------------------------------------------------
# The 16 Terminal Colors (Muted/Desaturated)
# -----------------------------------------------------------------------------

# Black / Charcoal
color0 #1c1c1c
color8 #3d3d3d

# Red (Muted)
color1 #d75f5f
color9 #d75f5f

# Green (Muted)
color2  #87af87
color10 #87af87

# Yellow (Muted)
color3  #dfaf87
color11 #dfaf87

# Blue (Muted)
color4  #87afaf
color12 #87afaf

# Magenta (Muted)
color5  #af87af
color13 #af87af

# Cyan (Muted)
color6  #87afd7
color14 #87afd7

# White (Platinum)
color7  #e5e5e5
color15 #ffffff

# Visual Cursor Trail (from old config)
cursor_trail 1

# Terminal Sound Effects:
# The sound play commands are triggered in ~/.config/fish/config.fish:
# - Startup (Kiss): ~/.config/kitty/Kiss.m4a
# - Shutdown (WinXP): ~/.config/kitty/windows-xp-shutdown.mp3

# -----------------------------------------------------------------------------
# Key Mappings (Ghostty-like Word Navigation)
# -----------------------------------------------------------------------------

# Make ctrl+backspace delete a single path component (acts like Alt+Backspace)
map ctrl+backspace send_text all \x1b\x7f

# Make ctrl+left move by path components (acts like Alt+Left)
map ctrl+left send_text all \x1bb
