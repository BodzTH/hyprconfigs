/* ~/.config/gtk-3.0/gtk.css */
/* HyprBlur (Elegant Monochrome) Theme for GTK3 applications */

@define-color theme_bg_color #111111;
@define-color theme_fg_color #e5e5e5;
@define-color theme_base_color #111111;
@define-color theme_text_color #e5e5e5;
@define-color theme_selected_bg_color @accent_color;
@define-color theme_selected_fg_color @accent_fg_color;
@define-color theme_tooltip_bg_color #0a0a0a;
@define-color theme_tooltip_fg_color #e5e5e5;
@define-color theme_headerbar_bg_color #1c1c1c;
@define-color theme_headerbar_fg_color #e5e5e5;

@define-color view_bg_color #111111;
@define-color view_fg_color #e5e5e5;
@define-color headerbar_bg_color #1c1c1c;
@define-color headerbar_fg_color #e5e5e5;
@define-color card_bg_color #1c1c1c;
@define-color card_fg_color #e5e5e5;
@define-color popover_bg_color #1c1c1c;
@define-color popover_fg_color #e5e5e5;
@define-color window_bg_color #111111;
@define-color window_fg_color #e5e5e5;

/* State & Accent Overrides */
@define-color accent_color #{{ template "accent" . }};
@define-color accent_bg_color #{{ template "accent" . }};
@define-color accent_fg_color #{{ template "accent_fg" . }};
@define-color destructive_color #555555;
@define-color destructive_bg_color #555555;
@define-color destructive_fg_color #e5e5e5;
@define-color success_color #ffffff;
@define-color success_bg_color #ffffff;
@define-color success_fg_color #111111;
@define-color warning_color #888888;
@define-color warning_bg_color #888888;
@define-color warning_fg_color #111111;
@define-color error_color #555555;
@define-color error_bg_color #555555;
@define-color error_fg_color #e5e5e5;
